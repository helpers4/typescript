{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./presets/oxlint/strict.json"],
  "overrides": [
    {
      "files": [
        "scripts/**/*.ts"
      ],
      "rules": {
        "no-explicit-any": "off",
        "no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": [
    "build",
    "coverage",
    "node_modules",
    "reports",
    ".stryker-tmp"
  ]
}
