{
  "name": "@helpers4/helpers4",
  "version": "3.1.12",
  "author": "baxyz <craft@baxyz.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helpers4/typescript.git"
  },
  "description": "A set of helpers in TS/JS, compatible with tree-shaking, which helps you to manipulate URL, Observable, Promise, ...",
  "keywords": [
    "helper",
    "typescript",
    "tree-shaking",
    "URL",
    "remove-ending-slash",
    "add-leading-slash",
    "extract-pure-uri",
    "string",
    "capitalize",
    "promise",
    "meaningPromiseOrThrow",
    "observable",
    "json",
    "combine"
  ],
  "license": "LGPL-3.0-or-later",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "pnpm build && vitest bench --run",
    "bench:watch": "vitest bench",
    "build": "tsx scripts/build/index.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "coherency": "tsx scripts/coherency/index.ts",
    "coherency:bundle": "tsx scripts/coherency/bundle/index.ts",
    "coherency:unified": "tsx scripts/coherency/unified/index.ts",
    "coherency:presets": "tsx scripts/coherency/presets/index.ts",
    "coherency:version": "tsx scripts/coherency/version/index.ts",
    "coherency:category": "tsx scripts/coherency/category/index.ts",
    "coherency:dependencies": "tsx scripts/coherency/dependencies/index.ts",
    "coherency:sizes": "tsx scripts/coherency/sizes/index.ts",
    "coherency:jsdoc-since": "tsx scripts/coherency/jsdoc-since/index.ts",
    "coherency:no-dom": "tsx scripts/coherency/no-dom/index.ts",
    "unpublish:version": "tsx scripts/publish/unpublish-version.ts",
    "examples": "tsx scripts/examples/index.ts",
    "smoke": "tsx scripts/examples/smoke.ts",
    "changelog:unreleased": "git-cliff --unreleased",
    "mutation": "stryker run",
    "mutation:fresh": "stryker run --force",
    "mutation:category": "stryker run --mutate"
  },
  "type": "module",
  "peerDependencies": {
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "fs-extra": "^11.4.1",
    "git-cliff": "^2.14.2",
    "glob": "^14.0.3",
    "happy-dom": "^21.0.4",
    "json5": "2.2.3",
    "oxlint": "^1.89.0",
    "rollup": "^4.65.0",
    "rollup-plugin-dts": "^6.5.1",
    "rxjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.0.0",
    "browser": "ES2022+"
  },
  "runtimes": {
    "node": ">=26.0.0",
    "browser": "ES2022+"
  }
}
