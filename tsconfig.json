{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./presets/tsconfig/lib.json",
  "compilerOptions": {
    "paths": {
      "*": [
        "./*"
      ]
    },
    "incremental": true,
    "outDir": "build",
    "rootDir": ".",
    "inlineSourceMap": true,
    // Strict type checking: from presets/tsconfig/base.json
    // Note: The 'any' type is strictly forbidden in this codebase.
    // Use 'unknown' for truly unknown types, or specific union types.
    "traceResolution": false,
    "listEmittedFiles": false,
    "listFiles": false,
    "pretty": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "include": [
    "helpers/**/*.ts",
    "scripts/**/*.ts",
    "presets/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules/**",
    "build/**",
    "**/node_modules/**",
    "**/*.bench.ts"
  ],
  "compileOnSave": false
}
